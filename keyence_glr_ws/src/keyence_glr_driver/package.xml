<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>keyence_glr_driver</name>
  <version>0.1.0</version>
  <description>Modbus/TCP driver for Keyence GL-R via GC-1000 / GC-Link, plus a mock publisher for dev.</description>
  <maintainer email="jedayhotmail@gmail.com">tuibui</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>keyence_glr_msgs</exec_depend>
  <exec_depend>python3-pymodbus</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
